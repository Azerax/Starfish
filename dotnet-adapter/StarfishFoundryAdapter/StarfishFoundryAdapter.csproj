    <RootNamespace>Starfish.FoundryAdapter</RootNamespace>
    <PackageId>Starfish.FoundryAdapter</PackageId>
    <Description>Starfish governance adapter for Azure AI Foundry Agent Service (.NET).</Description>
  </PropertyGroup>

</Project>
