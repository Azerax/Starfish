# dependencies
node_modules/
.pnp
.pnp.js

# secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key

# build artifacts
packages/*/dist/
dist/
out/
build/
*.tsbuildinfo

# runtime / governance state
.starfish/
**/.starfish/
*.log
npm-debug.log*

# deprecated / not-Starfish material — kept on disk for history, out of the tracked tree.
# See DEPRECATED.md for what lives here and what supersedes each item.
deprecated/
_not-starfish/

# private security audit — UNPATCHED findings against Starfish itself. NEVER commit: publishing
# live vulnerabilities in a security product before they are fixed is the whole risk. Local only.
audit/

# art raw intermediates
art/fleet/_raw/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
docs/BRIDGE_LIVE_PLAN.md
docs/SEED_REFACTOR_PLAN.md
docs/FULL_GOVERNED_BUILD_PLAN.md
docs/HOOK_INTEGRITY_PLAN.md
docs/OVERLAY_USAGE.md
docs/ROUTE1_OVERLAY_PLAN.md
docs/R0_TEST_PROMPT.md
docs/STRATEGY_A_SECURITY_REVIEW.md
site/site.zip

# large binary archives / bundles — planning artifacts, not repo content
*.tgz
*.gz
docs/planning/*.zip
site/*.zip

# safe-to-delete scratch — device_bash (the sandbox's on-device shell) can't unlink files inside a
# mounted folder, so anything it needs to remove gets moved here instead of deleted. Review and
# delete this folder by hand whenever it's non-empty; nothing in it is ever repo content.
_to_delete/

# Starfish test-deploy: local plaintext copy of the Key Vault sidecar tokens, never commit.
# These are live bearer tokens for the sidecar's `worker` and `operator` identities — committing the
# operator one would hand any reader the authority to approve governed decisions (see F-9,
# ADVERSARIAL-QA.md §6). Deploy-StarfishTestEnv.ps1 writes this file and self-appends this rule.
azure/.local-test-tokens.json

# ...and its siblings. Everything below is GENERATED by Deploy-StarfishTestEnv.ps1 (see its §"seed"
# block, ~line 470) on each local test deploy: a seeded governance root carrying absolute Windows
# paths and machine-specific state, plus the seed input it derives. Re-running the deploy recreates
# them, so tracking them only produces churn and leaks local paths.
azure/.local-seed-root/
azure/.local-seed-config.json

# Superseded in-place backups from the 2026-08-03 serve.ts/validate.ts delivery. That work landed in
# commit 65b3974; these are the pre-patch copies the applier left behind, kept out of the tree rather
# than deleted so they can still be diffed if needed.
*.bak-[0-9]*_[0-9]*

# One-shot delivery bundles: a zip whose payload has already been applied and committed is a
# duplicate of the tree, not a source of truth.
serve_ts_verdict_fix_and_validation_governor.zip

