# dependencies
node_modules/
.pnp
.pnp.js

# secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key

# build artifacts
packages/*/dist/
dist/
out/
build/
*.tsbuildinfo

# runtime / governance state
.starfish/
**/.starfish/
*.log
npm-debug.log*

# deprecated / not-Starfish material — kept on disk for history, out of the tracked tree.
# See DEPRECATED.md for what lives here and what supersedes each item.
deprecated/
_not-starfish/

# private security audit — UNPATCHED findings against Starfish itself. NEVER commit: publishing
# live vulnerabilities in a security product before they are fixed is the whole risk. Local only.
audit/

# art raw intermediates
art/fleet/_raw/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
docs/BRIDGE_LIVE_PLAN.md
docs/SEED_REFACTOR_PLAN.md
docs/FULL_GOVERNED_BUILD_PLAN.md
docs/HOOK_INTEGRITY_PLAN.md
docs/OVERLAY_USAGE.md
docs/ROUTE1_OVERLAY_PLAN.md
docs/R0_TEST_PROMPT.md
docs/STRATEGY_A_SECURITY_REVIEW.md
site/site.zip

# large binary archives / bundles — planning artifacts, not repo content
*.tgz
*.gz
docs/planning/*.zip
site/*.zip

# safe-to-delete scratch — device_bash (the sandbox's on-device shell) can't unlink files inside a
# mounted folder, so anything it needs to remove gets moved here instead of deleted. Review and
# delete this folder by hand whenever it's non-empty; nothing in it is ever repo content.
_to_delete/
